#: immich_search.lua:516 immich_search.lua:1417
msgid "Immich search"
msgstr "Immich-Suche"

#: immich_search.lua:517
msgid "search Immich and show the hits in the lighttable"
msgstr "Immich durchsuchen und die Treffer im Leuchttisch anzeigen"

#: immich_search.lua:541
msgid "server URL"
msgstr "Server-URL"

#: immich_search.lua:542
msgid ""
"base URL of the Immich server without trailing slash, e.g. http://"
"immich.local:2283"
msgstr ""
"Basis-URL des Immich-Servers ohne abschließenden Schrägstrich, z. B. http://"
"immich.local:2283"

#: immich_search.lua:546
msgid "API key"
msgstr "API-Schlüssel"

#: immich_search.lua:547
msgid ""
"Immich API key with the permission asset.read (stored unencrypted in "
"darktablerc)"
msgstr ""
"Immich-API-Schlüssel mit der Berechtigung asset.read (wird unverschlüsselt "
"in der darktablerc gespeichert)"

#: immich_search.lua:551
msgid "path mapping"
msgstr "Pfadabbildung"

#: immich_search.lua:552
msgid ""
"CONTAINER=HOST pairs separated by ';' that translate Immich's originalPath "
"prefixes into local paths, e.g. /mnt/media/photos=/home/me/Pictures;/data=/"
"mnt/immich/library"
msgstr ""
"Paare CONTAINER=HOST, getrennt durch ';', die die originalPath-Präfixe von "
"Immich in lokale Pfade übersetzen, z. B. /mnt/media/photos=/home/me/"
"Pictures;/data=/mnt/immich/library"

#: immich_search.lua:556
msgid "tag prefix"
msgstr "Tag-Präfix"

#: immich_search.lua:557
msgid "parent tag under which each search result tag is created"
msgstr ""
"übergeordneter Tag, unter dem die Tags der Suchergebnisse angelegt werden"

#: immich_search.lua:561
msgid "timeout (seconds)"
msgstr "Zeitlimit (Sekunden)"

#: immich_search.lua:562
msgid "maximum time for one request to the Immich server"
msgstr "maximale Dauer einer Anfrage an den Immich-Server"

#: immich_search.lua:683
#, lua-format
msgid "path mapping entry '%s' is not CONTAINER=HOST"
msgstr "Eintrag '%s' der Pfadabbildung hat nicht die Form CONTAINER=HOST"

#: immich_search.lua:688
#, lua-format
msgid "path mapping entry '%s' has an empty side"
msgstr "Eintrag '%s' der Pfadabbildung hat eine leere Seite"

#: immich_search.lua:691
#, lua-format
msgid "path mapping entry '%s' must not contain '..'"
msgstr "Eintrag '%s' der Pfadabbildung darf kein '..' enthalten"

#: immich_search.lua:694
#, lua-format
msgid "container path '%s' must start with '/'"
msgstr "Container-Pfad '%s' muss mit '/' beginnen"

#: immich_search.lua:700
msgid ""
"path mapping is not set: enter CONTAINER=HOST pairs in preferences > lua "
"options > Immich search"
msgstr ""
"Pfadabbildung ist nicht gesetzt: Paare CONTAINER=HOST unter Einstellungen > "
"Lua-Optionen > Immich search eintragen"

#: immich_search.lua:733
msgid ""
"server URL is not set: enter it in preferences > lua options > Immich search"
msgstr ""
"Server-URL ist nicht gesetzt: unter Einstellungen > Lua-Optionen > Immich "
"search eintragen"

#: immich_search.lua:736
msgid "server URL is invalid (expected http(s)://host[:port])"
msgstr "Server-URL ist ungültig (erwartet: http(s)://host[:port])"

#: immich_search.lua:739
msgid ""
"API key is not set: create one in Immich (permission asset.read) and enter "
"it in preferences > lua options > Immich search"
msgstr ""
"API-Schlüssel ist nicht gesetzt: in Immich einen Schlüssel mit der "
"Berechtigung asset.read anlegen und unter Einstellungen > Lua-Optionen > "
"Immich search eintragen"

#: immich_search.lua:742
msgid "API key contains whitespace"
msgstr "API-Schlüssel enthält Leerzeichen"

#: immich_search.lua:769
msgid ""
"curl not found; install curl or set its path in preferences > lua options > "
"executable paths"
msgstr ""
"curl nicht gefunden; curl installieren oder den Pfad unter Einstellungen > "
"Lua-Optionen > Pfade zu ausführbaren Dateien eintragen"

#: immich_search.lua:822 immich_search.lua:842
msgid "cannot write a temporary file in darktable's temp directory"
msgstr ""
"temporäre Datei im Temp-Verzeichnis von darktable kann nicht geschrieben "
"werden"

#: immich_search.lua:837
msgid "cannot encode the request as JSON"
msgstr "Anfrage kann nicht als JSON kodiert werden"

#: immich_search.lua:872
msgid "invalid JSON in the server response"
msgstr "ungültiges JSON in der Serverantwort"

#: immich_search.lua:884
#, lua-format
msgid "Immich rejected the API key or its permissions (HTTP %d): %s"
msgstr ""
"Immich hat den API-Schlüssel oder seine Berechtigungen abgelehnt (HTTP %d): "
"%s"

#: immich_search.lua:886
#, lua-format
msgid "Immich error (HTTP %s): %s"
msgstr "Immich-Fehler (HTTP %s): %s"

#: immich_search.lua:893
#, lua-format
msgid "Immich server not reachable: %s"
msgstr "Immich-Server nicht erreichbar: %s"

#: immich_search.lua:896
msgid "curl is too old; version 7.76 or newer is required"
msgstr "curl ist zu alt; Version 7.76 oder neuer wird benötigt"

#: immich_search.lua:898
#, lua-format
msgid "curl failed (exit %d): %s"
msgstr "curl fehlgeschlagen (Exit-Code %d): %s"

#: immich_search.lua:931
msgid "dates must be entered as YYYY-MM-DD"
msgstr "Datumsangaben im Format JJJJ-MM-TT eingeben"

#: immich_search.lua:939
msgid ""
"enter a search text in the top field for the smart search, or set a filter"
msgstr ""
"für die Smart-Suche einen Suchtext ins oberste Feld eingeben oder einen "
"Filter setzen"

#: immich_search.lua:1052
msgid "a request is already running"
msgstr "es läuft bereits eine Anfrage"

#: immich_search.lua:1061
#, lua-format
msgid "internal error: %s"
msgstr "interner Fehler: %s"

#: immich_search.lua:1089
msgid "searching ..."
msgstr "suche ..."

#: immich_search.lua:1090
msgid "searching Immich ..."
msgstr "suche in Immich ..."

#: immich_search.lua:1094
msgid "Immich search running ..."
msgstr "Immich-Suche läuft ..."

#: immich_search.lua:1114
msgid "importing Immich results"
msgstr "Immich-Treffer werden importiert"

#: immich_search.lua:1173
#, lua-format
msgid "server %d s, import %d s"
msgstr "Server %d s, Import %d s"

#: immich_search.lua:1175
#, lua-format
msgid "%d of %d hits shown, %d without mapping, %d missing, %d skipped"
msgstr ""
"%d von %d Treffern angezeigt, %d ohne Abbildung, %d fehlend, %d übersprungen"

#: immich_search.lua:1178
msgid "no search text: filter search"
msgstr "ohne Suchtext: Filtersuche"

#: immich_search.lua:1202
msgid "checking ..."
msgstr "prüfe ..."

#: immich_search.lua:1215
#, lua-format
msgid "Immich %s reachable, but: %s"
msgstr "Immich %s erreichbar, aber: %s"

#: immich_search.lua:1221
#, lua-format
msgid "Immich %s reachable, API key accepted"
msgstr "Immich %s erreichbar, API-Schlüssel akzeptiert"

#: immich_search.lua:1229
msgid "on"
msgstr "an"

#: immich_search.lua:1229
msgid "off"
msgstr "aus"

#: immich_search.lua:1232
msgid "smart search"
msgstr "Smart-Suche"

#: immich_search.lua:1232
msgid "OCR"
msgstr "OCR"

#: immich_search.lua:1251
msgid "search text (smart) or file name (metadata)"
msgstr "Suchtext (Smart) oder Dateiname (Metadaten)"

#: immich_search.lua:1252
msgid ""
"smart: describe the image content; metadata: part of the file name, case-"
"insensitive"
msgstr ""
"Smart: Bildinhalt beschreiben; Metadaten: Teil des Dateinamens, Groß-/"
"Kleinschreibung egal"

#: immich_search.lua:1257
msgid "mode"
msgstr "Modus"

#: immich_search.lua:1258
msgid ""
"smart search uses the image content (CLIP), metadata search uses file name "
"and filters only"
msgstr ""
"Smart-Suche nutzt den Bildinhalt (CLIP), Metadaten-Suche nur Dateiname und "
"Filter"

#: immich_search.lua:1260
msgid "smart (image content)"
msgstr "Smart (Bildinhalt)"

#: immich_search.lua:1261
msgid "metadata"
msgstr "Metadaten"

#: immich_search.lua:1265
msgid "taken from (YYYY-MM-DD)"
msgstr "aufgenommen ab (JJJJ-MM-TT)"

#: immich_search.lua:1270
msgid "taken until (YYYY-MM-DD)"
msgstr "aufgenommen bis (JJJJ-MM-TT)"

#: immich_search.lua:1275
msgid "camera make"
msgstr "Kamerahersteller"

#: immich_search.lua:1280
msgid "camera model"
msgstr "Kameramodell"

#: immich_search.lua:1285
msgid "text in the image (OCR)"
msgstr "Text im Bild (OCR)"

#: immich_search.lua:1286
msgid ""
"matches text recognised inside the images; needs OCR enabled on the server"
msgstr ""
"findet im Bild erkannten Text; setzt aktivierte OCR auf dem Server voraus"

#: immich_search.lua:1291
msgid "favourites only"
msgstr "nur Favoriten"

#: immich_search.lua:1296
msgid "rating"
msgstr "Bewertung"

#: immich_search.lua:1297
msgid "exact Immich rating, 'any' disables the filter"
msgstr "exakte Immich-Bewertung, 'beliebig' schaltet den Filter ab"

#: immich_search.lua:1299
msgid "any"
msgstr "beliebig"

#: immich_search.lua:1303
msgid "max. hits"
msgstr "max. Treffer"

#: immich_search.lua:1304
msgid "smart search always returns this many hits when enough assets exist"
msgstr ""
"die Smart-Suche liefert immer so viele Treffer, sofern genug Bilder "
"vorhanden sind"

#: immich_search.lua:1315
msgid "open first hit in the darkroom"
msgstr "ersten Treffer in der Dunkelkammer öffnen"

#: immich_search.lua:1350
msgid "search"
msgstr "suchen"

#: immich_search.lua:1363
msgid "check connection"
msgstr "Verbindung prüfen"

#: immich_search.lua:1377
msgid "restore previous collection"
msgstr "vorherige Sammlung wiederherstellen"

#: immich_search.lua:1388
msgid "filters"
msgstr "Filter"

#: immich_search.lua:1397
msgid "result"
msgstr "Ergebnis"
